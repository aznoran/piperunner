; Godot iOS plugin descriptor. Goes in the exported project's ios/plugins/
; directory alongside the built static library.
;
; `initialization` and `deinitialization` are the C functions Godot calls to
; register and tear down the singletons; both are generated by the plugin
; template around the classes in firebase_singletons.h.

[config]
name="PipeRunnerFirebase"
binary="libpiperunner_firebase.a"
initialization="piperunner_firebase_init"
deinitialization="piperunner_firebase_deinit"

[dependencies]
; Firebase itself is pulled in by CocoaPods or SPM into the exported Xcode
; project — see docs/experiment.md. Listing the frameworks here would only
; duplicate what the podfile already links, and the two disagreeing is a
; link error nobody enjoys.
linked=[]
embedded=[]
system=[]
capabilities=[]
files=[]

[plist]
; Firebase reads its project settings from GoogleService-Info.plist, which is
; added to the Xcode project rather than declared here.
